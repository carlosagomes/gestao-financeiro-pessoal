# Copie para .env e preencha. Gere as chaves com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"                     -> DJANGO_SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  -> APP_ENCRYPTION_KEY
DJANGO_SECRET_KEY=
APP_ENCRYPTION_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=financas.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://financas.seudominio.com.br
# 1 quando estiver atrás de HTTPS (proxy/Cloudflare/Caddy): cookies seguros, HSTS, redireciona para https
DJANGO_HTTPS=0
POSTGRES_PASSWORD=
# No docker-compose o host é "db"; rodando fora do Docker, 127.0.0.1:5433
DATABASE_URL=postgres://gfp:SENHA@db:5432/gfp
# 0 = só o admin cria contas
APP_CADASTRO_ABERTO=1
